{
  "name": "clipmint",
  "version": "1.0.0",
  "private": true,
  "description": "Clipmint browser-based audio & video toolkit",
  "license": "MIT",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "preview": "wrangler pages dev out --port 8788",
    "deploy": "wrangler pages deploy out",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check:pages": "node scripts/check-pages.mjs",
    "predev": "node scripts/copy-ffmpeg.mjs && node scripts/copy-models.mjs && node scripts/fetch-models.mjs && node scripts/fetch-fonts.mjs",
    "prebuild": "node scripts/copy-ffmpeg.mjs && node scripts/copy-models.mjs && node scripts/fetch-models.mjs && node scripts/fetch-fonts.mjs",
    "postbuild": "node scripts/check-pages.mjs"
  },
  "dependencies": {
    "@ffmpeg/core": "0.12.10",
    "@ffmpeg/ffmpeg": "0.12.10",
    "@ffmpeg/util": "0.12.2",
    "@huggingface/transformers": "^4.3.2",
    "@mediapipe/tasks-vision": "^0.10.21",
    "next": "14.2.35",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "14.2.35",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vitest": "^3.2.4",
    "wrangler": "^4.154.0"
  },
  "engines": {
    "node": ">=20"
  }
}
